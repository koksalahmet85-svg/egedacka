# ── Zorunlu ──
POSTGRES_PASSWORD=degistir-guclu-sifre
# openssl rand -hex 32
JWT_SECRET=
# python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=
ENV=production
CORS_ORIGINS=["https://panel.egealfa.com"]

# ── Modüller (şimdilik kapalı: gelir Drive'dan takip ediliyor) ──
ENABLE_ACCOUNTING=false
ENABLE_PORTAL=false

# ── Drive gelir takibi ──
# Tablo URL'sindeki /d/<ID>/edit kısmı
DRIVE_INCOME_SPREADSHEET_ID=
# Servis hesabı anahtarı (konteyner içindeki yol). Tabloyu bu hesabın e-postasıyla "Görüntüleyen" paylaşın.
GOOGLE_SERVICE_ACCOUNT_JSON=/run/secrets/google-sa.json
DRIVE_SYNC_MINUTES=15
# BİLANÇO sayfasına otomatik yazma (Düzenleyen yetkisi gerekir)
DRIVE_WRITE_BILANCO=false

# ── Meta (Lead Ads webhook + Marketing API + WhatsApp Cloud API) ──
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=

# ── Cal.com (deneme antrenmanı rezervasyonu) ──
CALCOM_WEBHOOK_SECRET=

# ── Fatura: "mock" (dernek makbuzu / geliştirme) | "parasut" (e-Arşiv) ──
INVOICE_PROVIDER=mock
PARASUT_COMPANY_ID=
PARASUT_CLIENT_ID=
PARASUT_CLIENT_SECRET=
PARASUT_USERNAME=
PARASUT_PASSWORD=

# ── İş kuralları ──
DEFAULT_EXPECTED_TENURE_MONTHS=14
DASHBOARD_CACHE_SECONDS=60
