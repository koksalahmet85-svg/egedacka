// ════════════════════════════════════════════════════════════════════════════
//  EGE ALFA SPOR KULÜBÜ — Kulüp Yönetim Sistemi
//  Tek doğruluk kaynağı (single source of truth): bu dosya.
//  Migration'lar Prisma CLI ile üretilir; FastAPI tarafı asyncpg ile aynı
//  tabloları okur/yazar. Tüm tablo/kolon adları snake_case'e map'lenmiştir ki
//  ham SQL (analitik sorgular) temiz kalsın.
//
//  Prisma'nın ifade edemediği kurallar (exclusion constraint, CHECK, view)
//  prisma/migrations/*_constraints/migration.sql içindedir.
// ════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
//  KİMLİK & YETKİ
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN // kulüp yöneticisi — her şey
  MANAGER // sportif direktör — spor + İK
  COACH // kendi takımları, antrenman, ölçüm
  ACCOUNTANT // finans
  MARKETING // CRM, kampanya, ROI
  GUARDIAN // veli portalı — yalnız kendi çocukları

  @@map("role")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  staffId      Int?      @unique @map("staff_id")
  guardianId   Int?      @unique @map("guardian_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  staff     Staff?     @relation(fields: [staffId], references: [id])
  guardian  Guardian?  @relation(fields: [guardianId], references: [id])
  auditLogs AuditLog[]

  @@map("users")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String // "invoice.cancel", "athlete.update" ...
  entity    String
  entityId  String   @map("entity_id")
  diff      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
//  1) KOÇ & İK YÖNETİMİ
// ─────────────────────────────────────────────────────────────────────────────

enum Department {
  COACHING
  ADMINISTRATION
  MARKETING
  FINANCE
  OPERATIONS

  @@map("department")
}

enum EmploymentType {
  FULL_TIME // aylık sabit maaş
  PART_TIME // aylık sabit + ek ders
  HOURLY // seans/saat başı ücret

  @@map("employment_type")
}

model Staff {
  id             Int            @id @default(autoincrement())
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  phone          String?
  email          String?        @unique
  department     Department
  title          String // "Baş Antrenör", "Kondisyoner", "Muhasebe"
  employmentType EmploymentType @map("employment_type")
  monthlySalary  Decimal?       @map("monthly_salary") @db.Decimal(12, 2) // brüt
  hourlyRate     Decimal?       @map("hourly_rate") @db.Decimal(10, 2) // brüt
  coachLicense   String?        @map("coach_license") // TBF antrenör kademesi
  ibanEncrypted  String?        @map("iban_encrypted") // uygulama katmanında şifreli
  hireDate       DateTime       @map("hire_date") @db.Date
  terminatedAt   DateTime?      @map("terminated_at") @db.Date
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user            User?
  headCoachOf     Team[]            @relation("HeadCoach")
  teamAssignments TeamCoach[]
  trainingPlans   TrainingPlan[]
  sessions        TrainingSession[]
  shifts          Shift[]
  timeEntries     TimeEntry[]       @relation("TimeEntryStaff")
  approvedEntries TimeEntry[]       @relation("TimeEntryApprover")
  timesheets      Timesheet[]
  payrolls        Payroll[]
  assessments     Assessment[]
  ownedLeads      Lead[]
  leadActivities  LeadActivity[]

  @@index([department])
  @@map("staff")
}

enum FacilityType {
  COURT // basketbol sahası
  GYM // kuvvet salonu
  CONDITIONING // kondisyon / atletik alan
  CLASSROOM // video analiz / toplantı

  @@map("facility_type")
}

model Facility {
  id         Int          @id @default(autoincrement())
  name       String       @unique // "Ana Salon - Saha 1"
  type       FacilityType
  capacity   Int // eşzamanlı sporcu kapasitesi
  hourlyCost Decimal      @default(0) @map("hourly_cost") @db.Decimal(10, 2) // kira / maliyet dağıtımı
  address    String?
  isActive   Boolean      @default(true) @map("is_active")

  trainingPlans TrainingPlan[]
  sessions      TrainingSession[]
  shifts        Shift[]

  @@map("facilities")
}

enum ShiftType {
  TRAINING
  ADMIN_DESK
  EVENT
  GAME_DAY

  @@map("shift_type")
}

// Vardiya = planlanan çalışma bloğu. Antrenman seansları otomatik vardiya üretir.
model Shift {
  id         Int       @id @default(autoincrement())
  staffId    Int       @map("staff_id")
  facilityId Int?      @map("facility_id")
  type       ShiftType
  startsAt   DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime  @map("ends_at") @db.Timestamptz(3)
  note       String?

  staff    Staff     @relation(fields: [staffId], references: [id])
  facility Facility? @relation(fields: [facilityId], references: [id])

  @@index([staffId, startsAt])
  @@map("shifts")
}

enum TimeEntrySource {
  SESSION_AUTO // tamamlanan seanstan otomatik
  QR_CHECKIN // salonda QR ile giriş/çıkış
  MANUAL // idari düzeltme

  @@map("time_entry_source")
}

// Puantaj satırı: gerçekleşen çalışma.
model TimeEntry {
  id           Int             @id @default(autoincrement())
  staffId      Int             @map("staff_id")
  sessionId    Int?            @unique @map("session_id") // seans başına tek kayıt → idempotent
  clockIn      DateTime        @map("clock_in") @db.Timestamptz(3)
  clockOut     DateTime        @map("clock_out") @db.Timestamptz(3)
  minutes      Int
  source       TimeEntrySource
  approvedById Int?            @map("approved_by_id")
  approvedAt   DateTime?       @map("approved_at") @db.Timestamptz(3)
  timesheetId  Int?            @map("timesheet_id")

  staff      Staff            @relation("TimeEntryStaff", fields: [staffId], references: [id])
  approvedBy Staff?           @relation("TimeEntryApprover", fields: [approvedById], references: [id])
  session    TrainingSession? @relation(fields: [sessionId], references: [id])
  timesheet  Timesheet?       @relation(fields: [timesheetId], references: [id])

  @@index([staffId, clockIn])
  @@map("time_entries")
}

enum TimesheetStatus {
  DRAFT
  APPROVED
  LOCKED // bordroya işlendi, değiştirilemez

  @@map("timesheet_status")
}

// Aylık puantaj özeti → bordroya girdi.
model Timesheet {
  id           Int             @id @default(autoincrement())
  staffId      Int             @map("staff_id")
  period       DateTime        @db.Date // ayın 1'i
  totalMinutes Int             @default(0) @map("total_minutes")
  sessionCount Int             @default(0) @map("session_count")
  status       TimesheetStatus @default(DRAFT)

  staff   Staff       @relation(fields: [staffId], references: [id])
  entries TimeEntry[]
  payroll Payroll?

  @@unique([staffId, period])
  @@map("timesheets")
}

// ─────────────────────────────────────────────────────────────────────────────
//  TAKIM / SEZON
// ─────────────────────────────────────────────────────────────────────────────

model Season {
  id        Int      @id @default(autoincrement())
  name      String   @unique // "2026-2027"
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isActive  Boolean  @default(false) @map("is_active")

  teams      Team[]
  planPrices SeasonPlanPrice[]

  @@map("seasons")
}

enum TeamLevel {
  SCHOOL // basketbol okulu (U8-U11)
  DEVELOPMENT // altyapı gelişim
  PERFORMANCE // lig takımı

  @@map("team_level")
}

model Team {
  id               Int       @id @default(autoincrement())
  seasonId         Int       @map("season_id")
  name             String // "U 16-A"
  ageGroup         String    @map("age_group") // "U16"
  level            TeamLevel
  headCoachId      Int?      @map("head_coach_id")
  maxAthletes      Int       @default(15) @map("max_athletes")
  defaultFeePlanId Int?      @map("default_fee_plan_id")

  season         Season            @relation(fields: [seasonId], references: [id])
  headCoach      Staff?            @relation("HeadCoach", fields: [headCoachId], references: [id])
  defaultFeePlan FeePlan?          @relation(fields: [defaultFeePlanId], references: [id])
  coaches        TeamCoach[]
  memberships    TeamMembership[]
  trainingPlans  TrainingPlan[]
  sessions       TrainingSession[]
  games          Game[]

  @@unique([seasonId, name])
  @@map("teams")
}

model TeamCoach {
  teamId  Int    @map("team_id")
  staffId Int    @map("staff_id")
  role    String @default("ASSISTANT") // ASSISTANT | S&C | PHYSIO

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id])

  @@id([teamId, staffId])
  @@map("team_coaches")
}

// ─────────────────────────────────────────────────────────────────────────────
//  2) SPORCU & VELİ
// ─────────────────────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE

  @@map("gender")
}

enum AthleteStatus {
  TRIAL // deneme sürecinde
  ACTIVE
  FROZEN // dondurulmuş (sakatlık / sınav dönemi) — aidat kesilmez
  LEFT

  @@map("athlete_status")
}

model Athlete {
  id                    Int           @id @default(autoincrement())
  firstName             String        @map("first_name")
  lastName              String        @map("last_name")
  birthDate             DateTime      @map("birth_date") @db.Date
  gender                Gender
  status                AthleteStatus @default(ACTIVE)
  position              String? // PG | SG | SF | PF | C
  licenseNo             String?       @unique @map("license_no") // TBF lisans
  healthReportExpiresAt DateTime?     @map("health_report_expires_at") @db.Date
  photoConsent          Boolean       @default(false) @map("photo_consent") // KVKK: görsel paylaşım izni
  joinedAt              DateTime      @default(now()) @map("joined_at") @db.Date
  leftAt                DateTime?     @map("left_at") @db.Date
  leftReason            String?       @map("left_reason")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  guardians     AthleteGuardian[]
  memberships   TeamMembership[]
  attendances   Attendance[]
  assessments   Assessment[]
  gameStats     GameStat[]
  reports       PerformanceReport[]
  subscriptions Subscription[]
  invoices      Invoice[]
  sourceLead    Lead?               @relation("LeadConversion")
  ledgerEntries LedgerEntry[]

  @@index([status])
  @@index([lastName, firstName])
  @@map("athletes")
}

model Guardian {
  id                 Int       @id @default(autoincrement())
  fullName           String    @map("full_name")
  phone              String    @unique // E.164 — WhatsApp/SMS anahtarı
  email              String?
  taxIdEncrypted     String?   @map("tax_id_encrypted") // TCKN/VKN — e-Arşiv için, şifreli
  address            String?
  kvkkConsentAt      DateTime? @map("kvkk_consent_at") @db.Timestamptz(3) // açık rıza zamanı
  marketingConsentAt DateTime? @map("marketing_consent_at") @db.Timestamptz(3) // İYS ticari ileti onayı
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user          User?
  athletes      AthleteGuardian[]
  subscriptions Subscription[]
  invoices      Invoice[]
  payments      Payment[]

  @@map("guardians")
}

model AthleteGuardian {
  athleteId  Int     @map("athlete_id")
  guardianId Int     @map("guardian_id")
  relation   String // ANNE | BABA | VASİ
  isPrimary  Boolean @default(false) @map("is_primary")

  athlete  Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([athleteId, guardianId])
  @@index([guardianId])
  @@map("athlete_guardians")
}

// Takım geçmişi korunur (sezon içi takım değişikliği raporları bozmaz).
model TeamMembership {
  id        Int       @id @default(autoincrement())
  athleteId Int       @map("athlete_id")
  teamId    Int       @map("team_id")
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  jersey    Int?

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id])

  @@index([teamId, endDate])
  @@index([athleteId, endDate])
  @@map("team_memberships")
}

// ─────────────────────────────────────────────────────────────────────────────
//  ANTRENMAN PROGRAMLAMA
//  TrainingPlan  = haftalık tekrar eden şablon (Pzt 17:00-18:30, Saha 1)
//  TrainingSession = takvimde somut seans (şablondan üretilir, tek tek değişebilir)
// ─────────────────────────────────────────────────────────────────────────────

model TrainingPlan {
  id          Int       @id @default(autoincrement())
  teamId      Int       @map("team_id")
  coachId     Int       @map("coach_id")
  facilityId  Int       @map("facility_id")
  weekday     Int // ISO: 1=Pazartesi … 7=Pazar
  startTime   String    @map("start_time") // "17:00" (Europe/Istanbul)
  durationMin Int       @map("duration_min")
  validFrom   DateTime  @map("valid_from") @db.Date
  validTo     DateTime? @map("valid_to") @db.Date
  focus       String? // "Pick&Roll savunması"

  team     Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  coach    Staff             @relation(fields: [coachId], references: [id])
  facility Facility          @relation(fields: [facilityId], references: [id])
  sessions TrainingSession[]

  @@index([teamId])
  @@map("training_plans")
}

enum SessionType {
  TEAM
  INDIVIDUAL
  STRENGTH_CONDITIONING
  GAME
  TRIAL // deneme antrenmanı (CRM ile bağlı)

  @@map("session_type")
}

enum SessionStatus {
  PLANNED
  COMPLETED
  CANCELLED

  @@map("session_status")
}

model TrainingSession {
  id           Int           @id @default(autoincrement())
  planId       Int?          @map("plan_id")
  teamId       Int?          @map("team_id")
  coachId      Int           @map("coach_id")
  facilityId   Int           @map("facility_id")
  type         SessionType   @default(TEAM)
  status       SessionStatus @default(PLANNED)
  startsAt     DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime      @map("ends_at") @db.Timestamptz(3)
  focus        String?
  plannedRpe   Int?          @map("planned_rpe") // koçun hedeflediği yoğunluk (CR-10)
  notes        String?
  cancelReason String?       @map("cancel_reason")

  plan        TrainingPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  team        Team?          @relation(fields: [teamId], references: [id])
  coach       Staff          @relation(fields: [coachId], references: [id])
  facility    Facility       @relation(fields: [facilityId], references: [id])
  blocks      SessionBlock[]
  attendances Attendance[]
  timeEntry   TimeEntry?
  trials      TrialBooking[]

  // Aynı şablondan aynı başlangıçta iki seans üretilmez → hafta üretimi idempotent.
  @@unique([planId, startsAt])
  @@index([startsAt])
  @@index([teamId, startsAt])
  @@index([coachId, startsAt])
  @@map("training_sessions")
}

model Drill {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  category    String // ŞUT | SAVUNMA | ATLETİK | OYUN | ISINMA
  description String?
  videoUrl    String? @map("video_url")
  minAgeGroup String? @map("min_age_group")

  blocks SessionBlock[]

  @@map("drills")
}

// Seansın içeriği: dinamik haftalık program buradan okunur.
model SessionBlock {
  id          Int     @id @default(autoincrement())
  sessionId   Int     @map("session_id")
  drillId     Int?    @map("drill_id")
  order       Int
  durationMin Int     @map("duration_min")
  notes       String?

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  drill   Drill?          @relation(fields: [drillId], references: [id])

  @@unique([sessionId, order])
  @@map("session_blocks")
}

enum AttendanceStatus {
  PRESENT
  LATE
  EXCUSED // mazeretli
  ABSENT
  INJURED // salonda ama antrenmana katılamadı

  @@map("attendance_status")
}

model Attendance {
  sessionId  Int              @map("session_id")
  athleteId  Int              @map("athlete_id")
  status     AttendanceStatus
  rpe        Int? // seans sonrası algılanan zorluk (Borg CR-10)
  minutes    Int? // fiili katılım süresi; null → seans süresi
  recordedAt DateTime         @default(now()) @map("recorded_at") @db.Timestamptz(3)

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  athlete Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@id([sessionId, athleteId])
  @@index([athleteId])
  @@map("attendances")
}

// ─────────────────────────────────────────────────────────────────────────────
//  PERFORMANS & GELİŞİM METRİKLERİ
//  Esnek metrik kataloğu: yeni test eklemek = yeni satır, migration değil.
// ─────────────────────────────────────────────────────────────────────────────

enum MetricCategory {
  ANTHROPOMETRIC // boy, kilo, kulaç, oturma boyu
  ATHLETIC // sprint, CMJ, T-test, V-cut, Yo-Yo
  FUNDAMENTAL // koç değerlendirmesi 1-10 (dribbling, pas, şut …)
  WELLNESS

  @@map("metric_category")
}

model MetricDefinition {
  id             Int            @id @default(autoincrement())
  code           String         @unique // "sprint20", "cmj", "dribbling"
  name           String
  unit           String // "s", "cm", "kg", "puan"
  category       MetricCategory
  higherIsBetter Boolean        @map("higher_is_better")
  // Test-tekrar test tipik hatası (TE). SWC'yi aşan değişim bu gürültüden de büyük mü?
  typicalError   Decimal?       @map("typical_error") @db.Decimal(8, 3)

  measurements Measurement[]

  @@map("metric_definitions")
}

// Bir test günü / değerlendirme oturumu
model Assessment {
  id         Int      @id @default(autoincrement())
  athleteId  Int      @map("athlete_id")
  assessorId Int?     @map("assessor_id")
  assessedAt DateTime @map("assessed_at") @db.Date
  context    String? // "Sezon başı bataryası", "Ara dönem"
  coachNote  String?  @map("coach_note")

  athlete      Athlete       @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  assessor     Staff?        @relation(fields: [assessorId], references: [id])
  measurements Measurement[]

  @@index([athleteId, assessedAt])
  @@map("assessments")
}

model Measurement {
  id           Int     @id @default(autoincrement())
  assessmentId Int     @map("assessment_id")
  metricId     Int     @map("metric_id")
  value        Decimal @db.Decimal(10, 3)

  assessment Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  metric     MetricDefinition @relation(fields: [metricId], references: [id])

  @@unique([assessmentId, metricId])
  @@index([metricId])
  @@map("measurements")
}

model Game {
  id           Int      @id @default(autoincrement())
  teamId       Int      @map("team_id")
  opponent     String
  playedAt     DateTime @map("played_at") @db.Timestamptz(3)
  isHome       Boolean  @map("is_home")
  competition  String? // "İzmir U16 Ligi"
  scoreFor     Int?     @map("score_for")
  scoreAgainst Int?     @map("score_against")

  team  Team       @relation(fields: [teamId], references: [id])
  stats GameStat[]

  @@index([teamId, playedAt])
  @@map("games")
}

// Kutu skor — sayı, ribaund, asist … Verimlilik metrikleri SQL'de türetilir.
model GameStat {
  gameId    Int @map("game_id")
  athleteId Int @map("athlete_id")
  minutes   Int @default(0)
  pts       Int @default(0)
  fgm       Int @default(0)
  fga       Int @default(0)
  tpm       Int @default(0) // 3PM
  tpa       Int @default(0)
  ftm       Int @default(0)
  fta       Int @default(0)
  oreb      Int @default(0)
  dreb      Int @default(0)
  ast       Int @default(0)
  stl       Int @default(0)
  blk       Int @default(0)
  tov       Int @default(0)
  pf        Int @default(0)

  game    Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@id([gameId, athleteId])
  @@index([athleteId])
  @@map("game_stats")
}

// Aylık veli raporu: üretim anındaki özet dondurulur (snapshot) → sonradan
// gelen düzeltmeler yayımlanmış raporu değiştirmez.
model PerformanceReport {
  id          Int       @id @default(autoincrement())
  athleteId   Int       @map("athlete_id")
  period      DateTime  @db.Date // ayın 1'i
  summary     Json // attendance, load, metric deltas, game averages
  coachNote   String?   @map("coach_note")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  pdfUrl      String?   @map("pdf_url")

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, period])
  @@map("performance_reports")
}

// ─────────────────────────────────────────────────────────────────────────────
//  3) FİNANS & MUHASEBE
// ─────────────────────────────────────────────────────────────────────────────

model FeePlan {
  id                 Int     @id @default(autoincrement())
  name               String  @unique // "Altyapı Aylık", "Okul 2x/hafta"
  monthlyAmount      Decimal @map("monthly_amount") @db.Decimal(12, 2) // KDV dahil
  vatRate            Decimal @default(20) @map("vat_rate") @db.Decimal(5, 2)
  siblingDiscountPct Decimal @default(10) @map("sibling_discount_pct") @db.Decimal(5, 2)
  isActive           Boolean @default(true) @map("is_active")

  teams         Team[]
  subscriptions Subscription[]

  @@map("fee_plans")
}

// Sporcunun aidat aboneliği. Fatura bu kayıttan ay ay üretilir.
model Subscription {
  id             Int       @id @default(autoincrement())
  athleteId      Int       @map("athlete_id")
  guardianId     Int       @map("guardian_id") // fatura muhatabı
  feePlanId      Int       @map("fee_plan_id")
  discountPct    Decimal   @default(0) @map("discount_pct") @db.Decimal(5, 2) // burs / özel indirim
  discountReason String?   @map("discount_reason")
  billingDay     Int       @default(1) @map("billing_day") // 1-28
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  pausedUntil    DateTime? @map("paused_until") @db.Date // dondurma

  athlete  Athlete   @relation(fields: [athleteId], references: [id])
  guardian Guardian  @relation(fields: [guardianId], references: [id])
  feePlan  FeePlan   @relation(fields: [feePlanId], references: [id])
  invoices Invoice[]

  @@index([guardianId])
  @@index([athleteId])
  @@map("subscriptions")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED

  @@map("invoice_status")
}

enum EArchiveStatus {
  NOT_SENT
  QUEUED
  ACCEPTED // GİB'e iletildi
  REJECTED

  @@map("earchive_status")
}

// "Gecikmiş" ayrı bir statü değil; due_date < bugün AND kalan > 0 sorgusudur.
// Böylece gece çalışan bir job'ın statü güncellemeyi kaçırması veriyi bozmaz.
model Invoice {
  id             Int            @id @default(autoincrement())
  number         String         @unique // "EAF2026000000123" — e-Arşiv seri+sıra
  subscriptionId Int?           @map("subscription_id")
  guardianId     Int            @map("guardian_id")
  athleteId      Int?           @map("athlete_id")
  period         DateTime?      @db.Date // aidat dönemi (ayın 1'i)
  issueDate      DateTime       @map("issue_date") @db.Date
  dueDate        DateTime       @map("due_date") @db.Date
  subtotal       Decimal        @db.Decimal(12, 2) // KDV hariç, indirim sonrası
  vatAmount      Decimal        @map("vat_amount") @db.Decimal(12, 2)
  total          Decimal        @db.Decimal(12, 2)
  paidAmount     Decimal        @default(0) @map("paid_amount") @db.Decimal(12, 2) // denormalize; trigger ile güncel
  status         InvoiceStatus  @default(ISSUED)
  eArchiveStatus EArchiveStatus @default(NOT_SENT) @map("earchive_status")
  eArchiveUuid   String?        @unique @map("earchive_uuid") // ETTN
  pdfUrl         String?        @map("pdf_url")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  subscription Subscription?     @relation(fields: [subscriptionId], references: [id])
  guardian     Guardian          @relation(fields: [guardianId], references: [id])
  athlete      Athlete?          @relation(fields: [athleteId], references: [id])
  lines        InvoiceLine[]
  payments     Payment[]
  reminders    PaymentReminder[]

  // Aynı abonelik + dönem için ikinci fatura kesilemez → fatura job'ı idempotent.
  @@unique([subscriptionId, period])
  @@index([status, dueDate])
  @@index([guardianId])
  @@map("invoices")
}

model InvoiceLine {
  id          Int     @id @default(autoincrement())
  invoiceId   Int     @map("invoice_id")
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2) // KDV hariç
  discount    Decimal @default(0) @db.Decimal(12, 2)
  vatRate     Decimal @map("vat_rate") @db.Decimal(5, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2) // KDV dahil

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_lines")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD // POS
  ONLINE // iyzico / PayTR — kayıtlı kart, otomatik çekim

  @@map("payment_method")
}

model Payment {
  id           Int           @id @default(autoincrement())
  invoiceId    Int?          @map("invoice_id")
  guardianId   Int           @map("guardian_id")
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  paidAt       DateTime      @map("paid_at") @db.Timestamptz(3)
  receiptNo    String        @unique @map("receipt_no") // tahsilat makbuzu no
  providerRef  String?       @unique @map("provider_ref") // ödeme sağlayıcı işlem no → webhook idempotency
  note         String?
  recordedById Int?          @map("recorded_by_id")

  invoice  Invoice? @relation(fields: [invoiceId], references: [id])
  guardian Guardian @relation(fields: [guardianId], references: [id])

  @@index([paidAt])
  @@index([invoiceId])
  @@map("payments")
}

enum ReminderLevel {
  DUE_SOON // vadeden 3 gün önce
  OVERDUE_1 // +1 gün
  OVERDUE_7
  OVERDUE_15
  OVERDUE_30 // yönetici eskalasyonu

  @@map("reminder_level")
}

model PaymentReminder {
  id        Int           @id @default(autoincrement())
  invoiceId Int           @map("invoice_id")
  level     ReminderLevel
  channel   String // SMS | WHATSAPP | EMAIL
  sentAt    DateTime      @default(now()) @map("sent_at") @db.Timestamptz(3)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Her seviye bir kez → velinin aynı mesajı iki kez alması imkânsız.
  @@unique([invoiceId, level])
  @@map("payment_reminders")
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID

  @@map("payroll_status")
}

model Payroll {
  id           Int           @id @default(autoincrement())
  staffId      Int           @map("staff_id")
  period       DateTime      @db.Date
  timesheetId  Int?          @unique @map("timesheet_id")
  baseGross    Decimal       @map("base_gross") @db.Decimal(12, 2)
  hourlyGross  Decimal       @default(0) @map("hourly_gross") @db.Decimal(12, 2)
  bonus        Decimal       @default(0) @db.Decimal(12, 2)
  deductions   Decimal       @default(0) @db.Decimal(12, 2)
  // Net ve SGK/vergi kalemleri mali müşavir bordro yazılımından gelir;
  // sistem "işverene toplam maliyet"i gider olarak tanır.
  netPay       Decimal?      @map("net_pay") @db.Decimal(12, 2)
  employerCost Decimal       @map("employer_cost") @db.Decimal(12, 2)
  status       PayrollStatus @default(DRAFT)
  paidAt       DateTime?     @map("paid_at") @db.Timestamptz(3)

  staff     Staff      @relation(fields: [staffId], references: [id])
  timesheet Timesheet? @relation(fields: [timesheetId], references: [id])

  @@unique([staffId, period])
  @@map("payrolls")
}

enum ExpenseCategory {
  FACILITY_RENT
  EQUIPMENT
  TRAVEL // deplasman
  LEAGUE_FEES // lisans, hakem, organizasyon
  MARKETING
  UTILITIES
  TAX
  OTHER

  @@map("expense_category")
}

model Expense {
  id          Int             @id @default(autoincrement())
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2) // KDV dahil
  vatAmount   Decimal         @default(0) @map("vat_amount") @db.Decimal(12, 2)
  spentAt     DateTime        @map("spent_at") @db.Date
  vendor      String?
  description String?
  documentUrl String?         @map("document_url")
  campaignId  Int?            @map("campaign_id") // pazarlama gideri ↔ kampanya (ajans, baskı, etkinlik)

  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@index([spentAt])
  @@index([category, spentAt])
  @@map("expenses")
}

// ─────────────────────────────────────────────────────────────────────────────
//  4) SOSYAL MEDYA & CRM
// ─────────────────────────────────────────────────────────────────────────────

enum Channel {
  META_ADS // Facebook + Instagram Lead Ads
  GOOGLE_ADS
  TIKTOK_ADS
  ORGANIC_SOCIAL
  WEBSITE
  REFERRAL // veli tavsiyesi
  SCHOOL_EVENT // okul tanıtım / turnuva
  WALK_IN

  @@map("channel")
}

model Campaign {
  id             Int       @id @default(autoincrement())
  name           String
  channel        Channel
  externalId     String?   @map("external_id") // Meta campaign_id / Google campaign id
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  budget         Decimal?  @db.Decimal(12, 2)
  targetAgeGroup String?   @map("target_age_group")

  spends   AdSpendDaily[]
  leads    Lead[]
  expenses Expense[]

  @@unique([channel, externalId])
  @@map("campaigns")
}

// Reklam platformundan günlük çekilen harcama — ROI paydasının kaynağı.
model AdSpendDaily {
  campaignId    Int      @map("campaign_id")
  date          DateTime @db.Date
  spend         Decimal  @db.Decimal(12, 2)
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  platformLeads Int      @default(0) @map("platform_leads") // platformun raporladığı lead (bizim sayımla kıyas için)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([campaignId, date]) // upsert-dostu
  @@map("ad_spend_daily")
}

enum LeadStage {
  NEW
  CONTACTED
  TRIAL_SCHEDULED
  TRIAL_ATTENDED
  WON // kayıt oldu → Athlete
  LOST

  @@map("lead_stage")
}

model Lead {
  id             Int       @id @default(autoincrement())
  childName      String    @map("child_name")
  childBirthYear Int?      @map("child_birth_year")
  guardianName   String    @map("guardian_name")
  phone          String // E.164
  email          String?
  channel        Channel
  campaignId     Int?      @map("campaign_id")
  externalLeadId String?   @unique @map("external_lead_id") // Meta leadgen_id → webhook tekrarına karşı
  utmSource      String?   @map("utm_source")
  utmMedium      String?   @map("utm_medium")
  utmCampaign    String?   @map("utm_campaign")
  utmContent     String?   @map("utm_content")
  clickId        String?   @map("click_id") // fbclid / gclid → offline conversion geri bildirimi
  stage          LeadStage @default(NEW)
  lostReason     String?   @map("lost_reason")
  ownerId        Int?      @map("owner_id")
  kvkkConsentAt  DateTime? @map("kvkk_consent_at") @db.Timestamptz(3)
  firstContactAt DateTime? @map("first_contact_at") @db.Timestamptz(3) // speed-to-lead
  convertedAt    DateTime? @map("converted_at") @db.Timestamptz(3)
  athleteId      Int?      @unique @map("athlete_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  campaign   Campaign?      @relation(fields: [campaignId], references: [id])
  owner      Staff?         @relation(fields: [ownerId], references: [id])
  athlete    Athlete?       @relation("LeadConversion", fields: [athleteId], references: [id])
  activities LeadActivity[]
  trials     TrialBooking[]

  @@index([stage])
  @@index([phone])
  @@index([campaignId, createdAt])
  @@index([createdAt])
  @@map("leads")
}

enum ActivityType {
  CALL
  WHATSAPP
  SMS
  EMAIL
  NOTE
  STAGE_CHANGE

  @@map("activity_type")
}

// Aşama geçmişi → huni süreleri (lead→deneme kaç gün?) buradan ölçülür.
model LeadActivity {
  id        Int          @id @default(autoincrement())
  leadId    Int          @map("lead_id")
  type      ActivityType
  fromStage LeadStage?   @map("from_stage")
  toStage   LeadStage?   @map("to_stage")
  note      String?
  staffId   Int?         @map("staff_id")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  lead  Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  staff Staff? @relation(fields: [staffId], references: [id])

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

enum TrialStatus {
  BOOKED
  ATTENDED
  NO_SHOW
  CANCELLED

  @@map("trial_status")
}

model TrialBooking {
  id            Int         @id @default(autoincrement())
  leadId        Int         @map("lead_id")
  sessionId     Int         @map("session_id")
  status        TrialStatus @default(BOOKED)
  coachFeedback String?     @map("coach_feedback")
  coachRating   Int?        @map("coach_rating") // 1-5: koçun uygunluk değerlendirmesi
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  lead    Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  session TrainingSession @relation(fields: [sessionId], references: [id])

  @@unique([leadId, sessionId])
  @@map("trial_bookings")
}

// ─────────────────────────────────────────────────────────────────────────────
//  BİLDİRİM OUTBOX — SMS/WhatsApp/e-posta asla istek içinde gönderilmez.
//  Transaction içinde satır yazılır, worker gönderir (at-least-once, retry).
// ─────────────────────────────────────────────────────────────────────────────

enum OutboxStatus {
  PENDING
  SENT
  FAILED

  @@map("outbox_status")
}

model NotificationOutbox {
  id        BigInt       @id @default(autoincrement())
  channel   String // SMS | WHATSAPP | EMAIL
  recipient String
  template  String // "payment_overdue_7", "trial_reminder"
  payload   Json
  dedupeKey String       @unique @map("dedupe_key")
  status    OutboxStatus @default(PENDING)
  attempts  Int          @default(0)
  lastError String?      @map("last_error")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt    DateTime?    @map("sent_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("notification_outbox")
}

// ─────────────────────────────────────────────────────────────────────────────
//  TAHSİLAT DEFTERİ (Excel geçmişi)
//  Sistem öncesi aylık Excel tahsilat defterleri buraya içe aktarılır. Oyuncu
//  doğum tarihi/veli bilgisi defterde olmadığı için sporcu kaydı uydurulmaz;
//  satır player_key ile tutulur, athlete_id eşleştirme yapıldıkça dolar.
// ─────────────────────────────────────────────────────────────────────────────

enum LedgerKind {
  MONTHLY // tek aylık aidat
  PARTIAL // yarım / eksik / kalan aidat
  MULTI_MONTH // birden çok ay tek ödemede
  SEASON_UPFRONT // sezonluk peşin
  SEASON_INSTALLMENT // sezonluk taksit
  TEXTILE // forma / tekstil
  EVENT // deplasman, kamp, bilet
  ARREARS // geçmiş dönem borcu
  OTHER

  @@map("ledger_kind")
}

model LedgerImport {
  id         Int      @id @default(autoincrement())
  fileName   String   @map("file_name")
  sha256     String
  sheets     String[]
  rowCount   Int      @map("row_count")
  anomalies  Json // [{sheet, source_row, issue, detail}]
  importedBy Int?     @map("imported_by")
  importedAt DateTime @default(now()) @map("imported_at") @db.Timestamptz(3)

  entries LedgerEntry[]

  @@map("ledger_imports")
}

model LedgerEntry {
  id             BigInt        @id @default(autoincrement())
  importId       Int           @map("import_id")
  sheet          String // "EYLÜL 26"
  sourceRow      Int           @map("source_row")
  sheetMonth     DateTime      @map("sheet_month") @db.Date // defter ayı (nakit esası)
  paidOn         DateTime      @map("paid_on") @db.Date
  paidOnInferred Boolean       @map("paid_on_inferred")
  playerName     String        @map("player_name")
  playerKey      String        @map("player_key")
  multiPlayer    Boolean       @default(false) @map("multi_player") // "HASAN - KEREM" gibi kardeş satırı
  athleteId      Int?          @map("athlete_id")
  group          String // ALTYAPI | SPOR_OKULU | KIZ_TAKIMI | MASA_TENISI | KARMA
  periodLabel    String        @map("period_label") // ham DÖNEM metni
  kind           LedgerKind
  coveredMonths  DateTime[]    @map("covered_months") @db.Date
  scholarship    Boolean       @default(false)
  amount         Decimal       @db.Decimal(12, 2)
  duesAmount     Decimal       @map("dues_amount") @db.Decimal(12, 2)
  textileAmount  Decimal       @map("textile_amount") @db.Decimal(12, 2)
  channelRaw     String        @map("channel_raw")
  channel        String // POS | MAIL_ORDER | GARANTI | FINANSBANK | ISBANKASI | CASH | UNKNOWN
  method         PaymentMethod
  cancelled      Boolean       @default(false)
  note           String?

  import  LedgerImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  athlete Athlete?     @relation(fields: [athleteId], references: [id], onDelete: SetNull)

  // Aynı sayfa yeniden içe aktarılınca eski satırlar silinip yenisi yazılır (defter canlı belge).
  @@unique([sheet, sourceRow])
  @@index([sheetMonth])
  @@index([playerKey])
  @@map("ledger_entries")
}

enum PlanTier {
  EARLY // erken kayıt
  STANDARD
  LATE // geç kayıt

  @@map("plan_tier")
}

// Sezonluk plan fiyat kademeleri (ör. 2026-27 Altyapı: erken kayıt 107.000, standart 119.000).
// Analiz, defterdeki sezonluk ödemeleri bu kademelere eşler.
model SeasonPlanPrice {
  id         Int       @id @default(autoincrement())
  seasonId   Int       @map("season_id")
  group      String // ALTYAPI | SPOR_OKULU | ...
  tier       PlanTier
  label      String? // "Erken kayıt"
  price      Decimal   @db.Decimal(12, 2)
  validUntil DateTime? @map("valid_until") @db.Date // erken kayıt son günü

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, group, tier])
  @@map("season_plan_prices")
}
